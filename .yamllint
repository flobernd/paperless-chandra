extends: default

rules:
  # https://yamllint.readthedocs.io/en/stable/rules.html#module-yamllint.rules.document_start
  document-start: disable
  line-length:
    max: 140
    allow-non-breakable-words: true
  # The default rule reports the `on:` key of each workflow file.
  truthy:
    check-keys: false
